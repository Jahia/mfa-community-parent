{
  "name": "mfa-factors-login-ui",
  "description": "Shared sign-in UI for the MFA factors \u2014 a Jahia authentication template that performs username/password then TOTP / WebAuthn / email-code verification.",
  "version": "0.4.0-SNAPSHOT",
  "type": "module",
  "files": [
    "dist",
    "src/**/*.cnd",
    "settings",
    "static"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && yarn package",
    "clean": "rm -rf dist/",
    "dev": "vite build --watch",
    "package": "yarn pack --filename dist/package.tgz",
    "test": "vitest run",
    "watch": "yarn dev"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "modern-normalize": "^3.0.1",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@jahia/javascript-modules-library": "^0.9.2",
    "@jahia/vite-plugin": "^0.9.2",
    "@types/react": "^19.3.0",
    "i18next": "^26.7.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-i18next": "^17.1.12",
    "typescript": "^5.8.3",
    "typescript-plugin-css-modules": "^5.3.0",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "postcss": "^8.5.23",
    "vite": "^7.3.7"
  },
  "jahia": {
    "name": "MFA factors Login UI",
    "maven": {
      "groupId": "org.jahia.community"
    },
    "module-dependencies": "default,user-password-authentication-api,mfa-factors-totp",
    "module-type": "module",
    "required-version": "8.2.3.0",
    "server": "dist/server/index.js",
    "static-resources": "/dist/client,/dist/assets,/locales,/images,/icons"
  }
}
