<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>jahia-modules</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>8.2.3.0</version>
    </parent>

    <groupId>org.jahia.community</groupId>
    <artifactId>mfa-factors-totp</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <name>UPA - MFA factors - TOTP</name>
    <packaging>bundle</packaging>
    <description>Third-party Jahia module adding a TOTP (RFC 6238 / Google Authenticator)
        factor to the User Password Authentication (UPA) Multi-Factor Authentication framework.
    </description>

    <properties>
        <jahia-depends>user-password-authentication-api,graphql-dxm-provider,mfa-factors-extensions</jahia-depends>
        <jahia-module-type>module</jahia-module-type>
        <upa.version>0.2.0</upa.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <yarn.arguments>build:production</yarn.arguments>
    </properties>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.jahia.community</groupId>
            <artifactId>mfa-factors-extensions</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>user-password-authentication-api</artifactId>
            <version>${upa.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>graphql-dxm-provider</artifactId>
            <version>3.4.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.graphql-java</groupId>
            <artifactId>graphql-java-annotations</artifactId>
            <version>21.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
            <version>21.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.15</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Static/JCR mocking for the JCR-bound store tests (report scan cap, lazy
             re-encryption, grace re-grant). TotpUserStore hardcodes JCRTemplate.getInstance()
             and returns concrete JCRUserNode/JCRSessionWrapper beyond the reach of the
             subclass-fake pattern; mockito-inline (JUnit-4 compatible) mocks the static + those. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <version>4.11.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Guava is only needed at TEST time so Mockito can subclass the concrete JCRUserNode
             (its API references guava types). It ships transitively at runtime via jahia-impl;
             webauthn already gets it via yubico, totp does not, hence this test-only declaration. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.6.0-jre</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.1</version>
                <executions>
                    <execution>
                        <id>npm install node and yarn</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-yarn</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v22.20.0</nodeVersion>
                            <yarnVersion>v1.22.21</yarnVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>yarn lint</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                        <configuration>
                            <arguments>lint</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                        <configuration>
                            <arguments>${yarn.arguments}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <_dsannotations>*</_dsannotations>
                        <Import-Package>
                            ${jahia.plugin.projectPackageImport},
                            graphql.annotations.annotationTypes;version="[6.5,99)",
                            graphql.schema;version="[21.5,22)",
                            org.jahia.modules.graphql.provider.dxm;version="[3.4,4)",
                            org.jahia.modules.graphql.provider.dxm.osgi.annotations;version="[3.4,4)",
                            org.jahia.modules.graphql.provider.dxm.util;version="[3.4,4)",
                            org.jahia.services.content,
                            org.jahia.services.content.decorator,
                            org.jahia.services.usermanager,
                            org.jahia.settings,
                            org.jahia.api,
                            javax.servlet,
                            javax.servlet.http,
                            org.apache.commons.codec.binary,
                            org.apache.commons.lang3,
                            javax.crypto,
                            javax.crypto.spec,
                            javax.jcr,
                            javax.jcr.query,
                            org.slf4j;version="[1.7,2)",
                            org.jahia.modules.upa.mfa,
                            org.jahia.modules.upa.mfa.gql,
                            org.jahia.modules.upa.mfa.extensions,
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <!-- Instruments the unit tests and emits target/jacoco.exec + target/site/jacoco/jacoco.xml
                 (the report Sonar reads via the root pom's sonar.coverage.jacoco.xmlReportPaths). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- jacoco:prepare-agent injects the javaagent via the "argLine" property; surefire must be
                 told to consume it explicitly (it does not do so implicitly), and it must be a
                 late-bound (@{...}) reference so it is resolved at test-execution time, after jacoco has
                 set the property - not at POM-parse time, when it would still be empty. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
